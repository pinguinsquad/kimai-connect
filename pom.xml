<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>de.p10d</groupId>
    <artifactId>kimai-connect</artifactId>
    <version>0.1.3</version>
    <name>kimai-connect</name>
    <description>Kimai-Anbindung mit CLI, PDF-Zeitnachweisen und MCP-Server</description>
    <url>https://github.com/pinguinsquad/kimai-connect</url>
    <inceptionYear>2026</inceptionYear>

    <!-- Ziel von `mvn deploy` in release.yml (server-id github, Zugangsdaten setzt setup-java) -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/pinguinsquad/kimai-connect</url>
        </repository>
    </distributionManagement>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>p10d</name>
            <url>https://github.com/pinguinsquad</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/pinguinsquad/kimai-connect.git</connection>
        <developerConnection>scm:git:git@github.com:pinguinsquad/kimai-connect.git</developerConnection>
        <url>https://github.com/pinguinsquad/kimai-connect</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/pinguinsquad/kimai-connect/issues</url>
    </issueManagement>

    <properties>
        <java.version>25</java.version>
        <picocli.version>4.7.7</picocli.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <openhtmltopdf.version>1.1.83</openhtmltopdf.version>
        <!-- Reproducible Builds: bei jedem Release aktualisieren -->
        <project.build.outputTimestamp>2026-09-01T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- RestClient inkl. Auto-Konfiguration, ohne Web-Server -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <!-- Jackson 3 für API-Mapping und JSON-Ausgabe -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- CLI-Parsing -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-spring-boot-starter</artifactId>
            <version>${picocli.version}</version>
        </dependency>
        <!-- MCP-Server über stdio -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server</artifactId>
        </dependency>
        <!-- Zeitnachweis-PDFs: HTML-Template → PDF -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>${openhtmltopdf.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                </requireJavaVersion>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Drittlizenzen (Apache-2.0-Verträglichkeit): Report META-INF/kimai-connect-THIRD-PARTY.txt
                 im Jar; Build bricht bei GPL/AGPL-Abhängigkeiten oder fehlender Lizenzangabe ab -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>2.7.1</version>
                <executions>
                    <execution>
                        <id>third-party-licenses</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>add-third-party</goal>
                        </goals>
                        <configuration>
                            <excludedScopes>test</excludedScopes>
                            <generateBundle>true</generateBundle>
                            <failOnMissing>true</failOnMissing>
                            <failOnBlacklist>true</failOnBlacklist>
                            <excludedLicenses>
                                <excludedLicense>GNU General Public License, version 2</excludedLicense>
                                <excludedLicense>GNU General Public License, version 3</excludedLicense>
                                <excludedLicense>GNU Affero General Public License, version 3</excludedLicense>
                                <excludedLicense>GPL-2.0-only</excludedLicense>
                                <excludedLicense>GPL-3.0-only</excludedLicense>
                                <excludedLicense>AGPL-3.0-only</excludedLicense>
                            </excludedLicenses>
                            <!-- Schreibweisen zusammenführen, damit der Report lesbar bleibt -->
                            <licenseMerges>
                                <licenseMerge>Apache-2.0|Apache License, Version 2.0|The Apache Software License, Version 2.0|The Apache Software License, version 2.0|The Apache License, Version 2.0|Apache 2.0|Apache License 2.0|Apache License Version 2.0</licenseMerge>
                                <licenseMerge>MIT|MIT License|The MIT License</licenseMerge>
                                <licenseMerge>EPL-2.0|EPL 2.0|Eclipse Public License v2.0|Eclipse Public License - v 2.0</licenseMerge>
                                <licenseMerge>LGPL-2.1-or-later|GNU Lesser General Public License (LGPL), version 2.1 or later</licenseMerge>
                                <licenseMerge>BSD-3-Clause|The BSD License|BSD licence</licenseMerge>
                            </licenseMerges>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Sources- und Javadoc-Jar für die Veröffentlichung in GitHub Packages -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <!-- fehlende Kommentare sind kein Fehler, echte Javadoc-Fehler schon -->
                    <doclint>all,-missing</doclint>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- classifier=exec: normales Jar bleibt als Bibliothek nutzbar,
                 das eigenständig lauffähige Jar heißt …-exec.jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
